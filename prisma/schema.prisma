generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres (local + Vercel).
// DATABASE_URL = pooler (6543) for the app
// DIRECT_URL   = direct (5432) for prisma db push / migrate
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ImportRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  fileName  String
  total     Int
  clean     Int
  leads     Lead[]
}

model Lead {
  id              String    @id @default(cuid())
  runId           String
  run             ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  company         String
  score           Int
  tier            String
  junk            Boolean
  duplicateOf     String?
  reasons         String // JSON array
  raw             String // JSON of original row
  whyNow          String?
  tags            String    @default("[]") // JSON string[]
  enrichment      String? // JSON EnrichmentSnapshot
  lastVerified    DateTime?
  stage           String    @default("new")
  stageChangedAt  DateTime?
  prevTier        String?
  prevScore       Int?
  profile         String? // JSON LeadProfile
  scoreBreakdown  String? // JSON ScoreFactor[]
  followUpAt      DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
  activities      LeadActivity[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String
  summary   String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model EnrichmentCache {
  id            String   @id @default(cuid())
  domain        String   @unique
  payload       String // JSON
  robotsAllowed Boolean  @default(true)
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime
}

model Workflow {
  id          String        @id @default(cuid())
  name        String
  enabled     Boolean       @default(true)
  graph       String // JSON { nodes, edges }
  templateKey String?
  isTemplate  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]

  @@index([templateKey])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      String // pending | done | failed
  trigger     String
  leadId      String?
  leadLabel   String?
  nodeResults String // JSON array
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
}

model ReportEvent {
  id        String   @id @default(cuid())
  kind      String // a_tier | workflow_run | crm_push | enrich | stage_change | notify …
  summary   String
  payload   String   @default("{}")
  createdAt DateTime @default(now())
}
