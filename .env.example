# Supabase Postgres (required for Automate / Runs / Weekly report persistence)
# Copy from Supabase → Project Settings → Database → Connection string
# Use the pooler URI for DATABASE_URL and the direct URI for DIRECT_URL.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
